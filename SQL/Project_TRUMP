SELECT * FROM SpeSa_D_Nato;

-- Ora possiamo manipolare i dati 
--MAX 
SELECT MAX(spese_Decimal_mld) AS Max_SpeSa_D_Nato FROM SpeSa_D_Nato;

-- Vuoi sapere chi ha speso di piu tra tutti 
SELECT anno, regione, paese, spese_Decimal_mld
FROM SpeSa_D_Nato
WHERE spese_Decimal_mld = (
    SELECT MAX(spese_Decimal_mld) FROM SpeSa_D_Nato
);
 
 -- min 
 SELECT MIN(spese_Decimal_mld) AS Min_SpeSa_D_Nato FROM SpeSa_D_Nato;

 -- COUNT conteggia le righe 
 SELECT COUNT(spese_Decimal_mld) AS Count_SpeSa_D_Nato FROM SpeSa_D_Nato;
 SELECT COUNT(*) AS Count_SpeSa_D_Nato FROM SpeSa_D_Nato;

 --somma 
  SELECT SUM(spese_Decimal_mld) AS Sum_SpeSa_D_Nato FROM SpeSa_D_Nato;

 --Spesa Totale anno 
SELECT anno, SUM(spese_Decimal_mld) AS anno_SpeSa_D_Nato FROM SpeSa_D_Nato GROUP BY anno;

SELECT anno, SUM(spese_Decimal_mld) AS Totale_Per_Anno
FROM SpeSa_D_Nato
GROUP BY anno;

--MEDIA 
SELECT  AVG(spese_Decimal_mld) AS  Avg_SpeSa_D_Nato FROM SpeSa_D_Nato;

 --Spesa Media Regione
SELECT regione, AVG(spese_Decimal_mld) AS media_SpeSa_D_Nato  FROM SpeSa_D_Nato GROUP BY regione;

SELECT regione, AVG(spese_Decimal_mld) AS  Avg_SpeSa_D_Regione
FROM SpeSa_D_Nato
GROUP BY regione;
