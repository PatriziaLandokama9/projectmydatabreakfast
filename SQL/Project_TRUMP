--BETWEEN (per intervalli)
SELECT * FROM SpeSa_D_Nato WHERE spese_Decimal_mld BETWEEN 400 AND 800;

--IN (per elenchi multipli)
SELECT * FROM SpeSa_D_Nato WHERE regione IN ('Europa', 'Nord America');

--NOT (esclusioni)
SELECT * 
FROM SpeSa_D_Nato
WHERE regione NOT IN ('Totale NATO');

SELECT * 
FROM SpeSa_D_Nato
WHERE regione NOT IN ('Europa', 'Nord America');-- abbiamo escluso Europa e Nord Aerica

--DISTINCT (valori unici)
SELECT DISTINCT * FROM SpeSa_D_Nato;

SELECT DISTINCT regione FROM SpeSa_D_Nato;

--LIKE (ricerca testuale)
SELECT * FROM SpeSa_D_Nato WHERE paese LIKE '%USA%';
SELECT * FROM SpeSa_D_Nato WHERE paese LIKE '%t%';


--Funzione CASE (condizione logica)
SELECT anno, paese,
    CASE 
        WHEN spese_Decimal_mld > 700 THEN 'Alta Spesa'
        WHEN spese_Decimal_mld BETWEEN 400 AND 700 THEN 'Media Spesa'
        ELSE 'Bassa Spesa'
    END AS Categoria_Spesa
FROM SpeSa_D_Nato;

--ORDER BY combinato
SELECT * FROM SpeSa_D_Nato ORDER BY anno DESC, spese_Decimal_mld DESC;-- ultimo diventa primo
SELECT * FROM SpeSa_D_Nato ORDER BY anno ASC, spese_Decimal_mld ASC ;--primo diventa primo

